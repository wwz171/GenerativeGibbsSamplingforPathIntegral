<simulation verbosity='low'>
  <output prefix='simulation'>
    <properties stride='1000' filename='out'>  [ step, time{picosecond}, conserved, temperature{kelvin}, kinetic_cv, potential, pressure_cv{megapascal} ] </properties>
    <trajectory filename='pos' stride='100'> positions </trajectory>
    <!-- <checkpoint stride='200'/> -->
  </output>
  <total_steps>1_000_000</total_steps>
  <prng>
    <seed>32341</seed>
  </prng>
  <ffsocket name='lammps' mode='unix'>
    <address> h2o-pimd.32 </address>
  </ffsocket>
  <system>
    <initialize nbeads='32'>
      <file mode='pdb'> water-216.pdb </file>
      <velocities mode='thermal' units='kelvin'> 300 </velocities>
    </initialize>
    <forces>
      <force forcefield='lammps'> </force>
    </forces>
    <motion mode='dynamics'>
      <dynamics mode='nvt'>
        <timestep units='femtosecond'> 0.25 </timestep>
        <thermostat mode='pile_g'>
          <tau units='femtosecond'> 50 </tau>
          <pile_lambda> 0.5 </pile_lambda>
        </thermostat>
      </dynamics>
    </motion>
    <ensemble>
      <temperature units='kelvin'> 300 </temperature>
    </ensemble>
  </system>
</simulation>
